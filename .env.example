# Google AI Studio key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste_your_key_here

# Chat model. Free-tier quota is 20 requests/day PER MODEL, so switching
# models here gives you a fresh allowance.
CHAT_MODEL=gemini-3.5-flash-lite

# MySQL connection. The password is URL-escaped automatically, so put the
# raw value here even if it contains @ : / # characters.
MYSQL_PASSWORD=your_mysql_password
DB_USER=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=atliq_tshirts

# Optional: set this to override everything above with a full SQLAlchemy URL
# (handy for pointing at SQLite or Postgres instead).
# DATABASE_URL=sqlite:///local.db

# How many example rows to show the model per table when describing the schema.
SAMPLE_ROWS_IN_TABLE_INFO=3
